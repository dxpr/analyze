{% if value >= 0.75 %}
  {% set status = 'good' %}
  {% set active_label = range_max_label %}
{% elseif value >= 0.4 %}
  {% set status = 'fair' %}
  {% set active_label = range_mid_label %}
{% else %}
  {% set status = 'poor' %}
  {% set active_label = range_min_label %}
{% endif %}
{% set circumference = 326.73 %}
{% set offset = circumference - (circumference * value) %}
<div class="analyze-circular-gauge analyze-circular-gauge--{{ status }}"
     role="figure"
     aria-label="{{ caption }}: {{ display_value }}">
  <svg viewBox="0 0 120 120"
       aria-hidden="true"
       focusable="false"
       class="analyze-circular-gauge__svg">
    <circle cx="60" cy="60" r="52"
            fill="none" stroke-width="8"
            class="analyze-circular-gauge__track"/>
    <circle cx="60" cy="60" r="52"
            fill="none" stroke-width="8"
            stroke-dasharray="{{ circumference }}"
            stroke-dashoffset="{{ offset }}"
            stroke-linecap="round"
            transform="rotate(-90 60 60)"
            class="analyze-circular-gauge__fill"/>
  </svg>
  <div class="analyze-circular-gauge__center">
    <span class="analyze-circular-gauge__value">{{ display_value }}</span>
    <span class="analyze-circular-gauge__label">{{ active_label }}</span>
  </div>
</div>
